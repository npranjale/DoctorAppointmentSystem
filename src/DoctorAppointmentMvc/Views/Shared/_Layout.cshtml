<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - My Hospital</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main-content">Skip to main content</a>
<header class="site-header">
 <nav class="navbar navbar-expand-lg container" aria-label="Main navigation">
  <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index"><span class="brand-mark">+</span> My Hospital</a>
  <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu" aria-controls="navMenu" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
  <div class="collapse navbar-collapse" id="navMenu">
   <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-3">
    <li class="nav-item"><a class="nav-link" asp-controller="Doctors" asp-action="Index">Find a doctor</a></li>
    @if (User.Identity?.IsAuthenticated == true) {
      <li class="nav-item"><a class="nav-link" asp-controller="Appointments" asp-action="Index">My appointments</a></li>
      <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-primary btn-sm" type="submit">Sign out</button></form></li>
    } else {
      <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
      <li class="nav-item"><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a></li>
    }
   </ul>
  </div>
 </nav>
</header>
<main id="main-content" class="container page-content">
 @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
 @if (TempData["Info"] is string info) { <div class="alert alert-info" role="status">@info</div> }
 @RenderBody()
</main>
<footer class="site-footer"><div class="container d-flex flex-column flex-md-row justify-content-between gap-2"><span>© @DateTime.Now.Year My Hospital</span></div></footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
